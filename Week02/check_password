def check_password(pw):
    if len(pw) < 8:
        return False
    
    has_digit = False
    has_alpha = False
    
    for ch in pw:
        if ch.isdigit():
            has_digit = True
        if ch.isalpha():
            has_alpha = True
    
    return has_digit and has_alpha

pw = input("비밀번호를 입력하세요: ")
if check_password(pw):
    print("사용 가능한 비밀번호입니다")
else:
    print("조건을 만족하지 않습니다 (8자 이상, 숫자+영문 포함)")